-- FONCTION SOUS MENU
------------------------------------------------
local function createSubMenu(text)
	local SubFrame = Instance.new("Frame")
	SubFrame.Size = UDim2.new(1, 0, 0, 70)
	SubFrame.BackgroundColor3 = Color3.fromRGB(60, 0, 80) -- violet foncé
	SubFrame.BorderSizePixel = 0
	SubFrame.Parent = Scroll

	-- TEXTE
	local Label = Instance.new("TextLabel")
	Label.Position = UDim2.new(0, 10, 0, 10)
	Label.Size = UDim2.new(0.6, -20, 1, -20)
	Label.BackgroundTransparency = 1
	Label.Text = text
	Label.TextWrapped = true
	Label.TextColor3 = Color3.fromRGB(255, 255, 255)
	Label.Font = Enum.Font.Gotham
	Label.TextSize = 14
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = SubFrame

	-- BOUTON
	local Button = Instance.new("TextButton")
	Button.Position = UDim2.new(0.65, 0, 0.2, 0)
	Button.Size = UDim2.new(0.3, 0, 0.6, 0)
	Button.Text = "A REMPLACER"
	Button.BackgroundColor3 = Color3.fromRGB(90, 0, 120)
	Button.TextColor3 = Color3.fromRGB(255, 255, 255)
	Button.Font = Enum.Font.GothamBold
	Button.TextSize = 14
	Button.Parent = SubFrame

	-- SCRIPT CLIENT MODIFIABLE
	Button.MouseButton1Click:Connect(function()
		------------------------------------
		-- ICI TU METS TON SCRIPT CLIENT
		print("SCRIPT EXECUTÉ")
		------------------------------------

		Button.Text = "Executed"
		Button.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
	end)
end

