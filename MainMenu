local function createSubMenu(data)
	local SubFrame = Instance.new("Frame")
	SubFrame.Size = UDim2.new(1, 0, 0, 60)
	SubFrame.BackgroundColor3 = Color3.fromRGB(60, 0, 80)
	SubFrame.BorderSizePixel = 0
	SubFrame.Parent = Scroll

	local Label = Instance.new("TextLabel")
	Label.Position = UDim2.new(0, 10, 0, 0)
	Label.Size = UDim2.new(0.6, -20, 1, 0)
	Label.BackgroundTransparency = 1
	Label.Text = data.title
	Label.TextColor3 = Color3.fromRGB(255, 255, 255)
	Label.Font = Enum.Font.Gotham
	Label.TextSize = 14
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = SubFrame

	local Button = Instance.new("TextButton")
	Button.Position = UDim2.new(0.65, 0, 0.2, 0)
	Button.Size = UDim2.new(0.3, 0, 0.6, 0)
	Button.Text = "EXECUTE"
	Button.BackgroundColor3 = Color3.fromRGB(90, 0, 120)
	Button.TextColor3 = Color3.fromRGB(255, 255, 255)
	Button.Font = Enum.Font.GothamBold
	Button.TextSize = 14
	Button.Parent = SubFrame

	Button.MouseButton1Click:Connect(function()
		if data.onExecute then
			data.onExecute()
		end

		Button.Text = "DONE"
		Button.BackgroundColor3 = Color3.fromRGB(0, 120, 0)
	end)
end
for _, menuData in ipairs(SubMenus) do
	createSubMenu(menuData)
end
